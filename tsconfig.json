      "@teskooano/renderer-threejs-celestial": [
        "./packages/renderer/threejs-celestial/src"
      ],
      "@teskooano/core-state": ["./packages/core/state/src/index.ts"],
      "@teskooano/core-math": ["./packages/core/math/src/index.ts"],
      "@teskooano/data-types": ["./packages/data/types/src/index.ts"],
      "@teskooano/data-values": ["./packages/data/values/src/index.ts"],
      "@teskooano/app-simulation": [
        "./packages/app/simulation/src/Simulation.ts"
      ],
