    },
    {
      "path": "./packages/renderer/threejs-celestial"
    },
    {
      "path": "./packages/renderer/threejs-controls"
    },
    {
      "path": "./packages/renderer/threejs-labels"
    },
    {
      "path": "./packages/renderer/threejs-objects"
    },
    {
      "path": "./packages/renderer/threejs-orbits"
    },
    {
      "path": "./packages/renderer/threejs-background"
    },
    {
      "path": "./packages/renderer/threejs-camera"
    },
    {
      "path": "./packages/renderer/threejs-helpers"
    },
    {
      "path": "./packages/app/simulation"
    },
    {
      "path": "./packages/app/notifications"
    },
    {
      "path": "./packages/app/web-apis"
    },
    {
      "path": "./packages/systems/procedural-generation"
    },
    {
      "path": "./packages/systems/solar-system"
    },
    { "path": "./packages/celestials/comet" },
    { "path": "./packages/celestials/terrestrial" },
    { "path": "./packages/celestials/rings" },
    { "path": "./packages/celestials/gas-giants" },
    { "path": "./packages/celestials/stars" },
    { "path": "./packages/celestials/asteroid-field" },
    { "path": "./packages/celestials/oort-cloud" },
    { "path": "./packages/celestials/asteroid" },
    { "path": "./packages/celestials/satellite" }
  ],
  "include": ["packages/**/*", "apps/**/*", "glsl.d.ts"],
  "exclude": ["node_modules", "dist"]
}
