formulas:
  Number of Classes: list(classes).unique().length
  Total Dependencies: list(dependencies).unique().length
  Total Classes: classes.length
properties:
  formula.Number of Classes:
    displayName: Used Classes
views:
  - type: table
    name: Table
    order:
      - file.name
      - package
      - formula.Number of Classes
      - formula.Total Dependencies
      - formula.Total Classes
    sort:
      - property: formula.Total Classes
        direction: DESC
      - property: formula.Total Dependencies
        direction: DESC
      - property: formula.Number of Classes
        direction: DESC
    columnSize:
      note.package: 279
  - type: cards
    name: View
    cardSize: 290
