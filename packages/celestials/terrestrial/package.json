{
  "name": "@teskooano/celestials-terrestrial",
  "version": "0.4.0-dev.0",
  "private": true,
  "description": "Renderer for terrestrial planets and moons",
  "keywords": [
    "threejs",
    "planet",
    "moon",
    "space"
  ],
  "license": "ISC",
  "author": "Tane Piper <hello@tanepiper.com>",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --browser=chromium",
    "test:browser": "vitest --browser",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@teskooano/data-types": "file:../../data/types",
    "@teskooano/renderer-threejs-celestial": "file:../../renderer/threejs-celestial",
    "@teskooano/celestials-rings": "file:../../celestials/rings",
    "@types/three": "0.182.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/node": "25.0.10",
    "@vitest/browser": "4.0.18",
    "@vitest/ui": "4.0.18",
    "eslint": "9.39.2",
    "happy-dom": "20.3.9",
    "playwright": "1.58.0",
    "typescript": "5.9.3",
    "vite-plugin-glsl": "1.5.5",
    "vitest": "4.0.18"
  }
}
