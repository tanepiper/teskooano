{
  "name": "@teskooano/celestials-rings",
  "version": "0.4.0-dev.0",
  "private": true,
  "description": "Renderer for planetary ring systems",
  "keywords": [
    "threejs",
    "rings",
    "space"
  ],
  "license": "ISC",
  "author": "Tane Piper <hello@tanepiper.com>",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --browser=chromium",
    "test:browser": "vitest --browser",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@teskooano/core-debug": "file:../../core/debug",
    "@teskooano/data-types": "file:../../data/types",
    "@teskooano/renderer-threejs-celestial": "file:../../renderer/threejs-celestial",
    "@types/three": "0.179.0",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@vitest/browser": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "9.34.0",
    "happy-dom": "18.0.1",
    "playwright": "1.55.0",
    "typescript": "5.9.2",
    "vite-plugin-glsl": "1.5.1",
    "vitest": "3.2.4"
  }
}
