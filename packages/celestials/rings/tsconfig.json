{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@teskooano/core-debug": ["../../core/debug/src"],
      "@teskooano/data-types": ["../../data/types/src"],
      "@teskooano/renderer-threejs-celestial": [
        "../../renderer/threejs-celestial/src"
      ]
    }
  },
  "references": [
    { "path": "../../core/debug" },
    { "path": "../../data/types" },
    { "path": "../../renderer/threejs-celestial" }
  ],
  "include": ["src/**/*", "src/shims-glsl.d.ts"],
  "exclude": ["node_modules", "dist"]
}
