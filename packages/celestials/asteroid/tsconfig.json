{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@teskooano/data-types": ["../../data/types/src"],
      "@teskooano/renderer-threejs-celestial": [
        "../../renderer/threejs-celestial/src"
      ],
      "@teskooano/renderer-threejs-lod": ["../../renderer/threejs-lod/src"]
    }
  },
  "references": [
    { "path": "../../data/types" },
    { "path": "../../renderer/threejs-celestial" },
    { "path": "../../renderer/threejs-lod" }
  ],
  "include": ["src/**/*"],
  "files": ["src/vite-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
