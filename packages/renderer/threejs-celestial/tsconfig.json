{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "composite": true,
    "paths": {
      "@teskooano/core-state": ["../../core/state/src/index.ts"],
      "@teskooano/data-types": ["../../data/types/src/index.ts"],
      "@teskooano/renderer-threejs-lighting": [
        "../threejs-lighting/src/index.ts"
      ],
      "@teskooano/web-apis": ["../../web-apis/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"],
  "references": [
    { "path": "../../core/state" },
    { "path": "../../data/types" },
    { "path": "../threejs-lighting" },
    { "path": "../../app/web-apis" }
  ]
}
