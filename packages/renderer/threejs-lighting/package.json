{
  "name": "@teskooano/renderer-threejs-lighting",
  "version": "0.4.0-dev.0",
  "private": true,
  "description": "Handles scene lighting for the Teskooano Three.js renderer.",
  "keywords": [
    "teskooano",
    "threejs",
    "renderer",
    "lighting"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:browser": "vitest",
    "test:watch": "vitest",
    "test:browser:watch": "vitest",
    "test:browser:headless": "vitest --browser.headless",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@teskooano/core-math": "file:../../core/math",
    "@teskooano/core-state": "file:../../core/state",
    "@teskooano/data-types": "file:../../data/types",
    "@teskooano/renderer-threejs-core": "file:../threejs-core",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/three": "0.179.0",
    "@playwright/test": "1.55.0",
    "@vitest/browser": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "9.34.0",
    "happy-dom": "18.0.1",
    "playwright": "1.55.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
