{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@teskooano/renderer-threejs-core": ["../threejs-core/src"]
    },
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib"],
  "references": [{ "path": "../threejs-core" }]
}
