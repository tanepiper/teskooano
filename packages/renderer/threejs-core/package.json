{
  "name": "@teskooano/renderer-threejs-core",
  "version": "0.4.0-dev.0",
  "private": true,
  "description": "Core components for the ThreeJS renderer (Scene, Animation, State)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:browser": "vitest",
    "test:watch": "vitest",
    "test:browser:watch": "vitest",
    "test:browser:headless": "vitest --browser.headless",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@teskooano/core-state": "file:../../core/state",
    "@teskooano/data-types": "file:../../data/types",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@types/three": "0.181.0",
    "@playwright/test": "1.56.1",
    "@vitest/browser": "4.0.13",
    "@vitest/ui": "4.0.13",
    "eslint": "9.39.1",
    "happy-dom": "20.0.10",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "4.0.13"
  }
}
