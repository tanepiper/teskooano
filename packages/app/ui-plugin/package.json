{
  "name": "@teskooano/ui-plugin",
  "version": "0.4.0-dev.0",
  "private": true,
  "description": "Core UI plugin system for Teskooano applications.",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./patterns": {
      "import": {
        "types": "./dist/patterns/index.d.ts",
        "default": "./dist/patterns/index.js"
      }
    },
    "./vite.js": {
      "import": {
        "types": "./dist/vite-plugin.d.ts",
        "default": "./dist/vite-plugin.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dockview-core": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "typescript": "5.9.2",
    "eslint": "9.33.0",
    "prettier": "3.6.2",
    "rxjs": "7.8.2",
    "@typescript-eslint/eslint-plugin": "8.39.1",
    "@typescript-eslint/parser": "8.39.1",
    "vite": "7.1.2"
  },
  "peerDependencies": {
    "dockview-core": "1.13.0",
    "vite": "5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
