{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "paths": {
      "@teskooano/data-types": ["../../data/types/src"],
      "@teskooano/core-physics": ["../physics/src"],
      "@teskooano/core-math": ["../math/src"]
    },
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../../data/types"
    },
    {
      "path": "../physics"
    },
    {
      "path": "../math"
    }
  ]
}
